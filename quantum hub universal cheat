local function FullCleanup()
    if IsUnloaded then return end
    IsUnloaded = true

    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Connections)

    pcall(function() FOVCircle:Remove() end)
    pcall(function() TargetSnapLine:Remove() end)
    pcall(function() TargetLockRing:Remove() end)

    for model, _ in pairs(ESP_Objects) do
        RemoveESPData(model)
    end

    for model, _ in pairs(ActiveEntities) do
        RestoreCharacterHitboxes(model)
        local hl = model and model:FindFirstChild("QuantumChams")
        if hl then pcall(function() hl:Destroy() end) end
    end
    table.clear(ActiveEntities)
    table.clear(DiscoveredBotModels)

    for part, canCol in pairs(LocalPlayerNoclipCache) do
        if part and part.Parent then
            pcall(function() part.CanCollide = canCol end)
        end
    end
    table.clear(LocalPlayerNoclipCache)

    local lChar = LocalPlayer.Character
    local lHrp = lChar and lChar:FindFirstChild("QuantumAuraEmitter", true)
    if lHrp then pcall(function() lHrp:Destroy() end) end

    pcall(function()
        Lighting.ClockTime = OriginalLighting.ClockTime
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.FogEnd = OriginalLighting.FogEnd
        for _, obj in ipairs(CreatedLightingObjects) do
            if obj and obj.Parent then obj:Destroy() end
        end
    end)

    if ScreenGui and ScreenGui.Parent then
        pcall(function() ScreenGui:Destroy() end)
    end
end

