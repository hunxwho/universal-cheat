local function DeepReplace(tbl, targetPos, targetCF, targetInst)
    for k, v in pairs(tbl) do
        if type(v) == "Vector3" then
            tbl[k] = targetPos
        elseif type(v) == "CFrame" then
            tbl[k] = targetCF
        elseif typeof(v) == "Instance" and v:IsA("BasePart") then
            tbl[k] = targetInst
        elseif type(v) == "table" then
            DeepReplace(v, targetPos, targetCF, targetInst)
        end
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if QuantumConfig.SilentAim and not checkcaller() then
        if math.random(1, 100) <= QuantumConfig.HitChance then
            local targetChar = GetClosestTargetToCursor()
            if targetChar and IsAliveAndValid(targetChar) then
                local targetPart = GetTargetPart(targetChar)
                if targetPart then
                    local hitPos = GetPredictedPosition(targetPart)
                    local hitCF = CFrame.new(hitPos)
                    
                    if method == "Raycast" or method == "Spherecast" or method == "Blockcast" then
                        local origMag = (typeof(args[2]) == "Vector3" and args[2].Magnitude) or 1000
                        args[2] = (hitPos - args[1]).Unit * math.max(origMag, 1000)
                        return oldNamecall(self, unpack(args))
                    elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                        local origMag = (typeof(args[1]) == "Ray" and args[1].Direction.Magnitude) or 1000
                        args[2] = (hitPos - args[1].Origin).Unit * math.max(origMag, 1000)
                        return oldNamecall(self, unpack(args))
                    elseif method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                        local origin = Camera.CFrame.Position
                        local direction = (hitPos - origin).Unit
                        return Ray.new(origin, direction)
                    elseif method == "FireServer" or method == "InvokeServer" then
                        for i, v in pairs(args) do
                            if typeof(v) == "Vector3" then
                                args[i] = hitPos
                            elseif typeof(v) == "CFrame" then
                                args[i] = hitCF
                            elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                                args[i] = targetPart
                            elseif type(v) == "table" then
                                DeepReplace(v, hitPos, hitCF, targetPart)
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if QuantumConfig.SilentAim and not checkcaller() then
        if math.random(1, 100) <= QuantumConfig.HitChance then
            local targetChar = GetClosestTargetToCursor()
            if targetChar and IsAliveAndValid(targetChar) then
                local targetPart = GetTargetPart(targetChar)
                if targetPart then
                    local hitPos = GetPredictedPosition(targetPart)
                    if self == Mouse and (key == "Target" or key == "Hit") then
                        if key == "Target" then
                            return targetPart
                        elseif key == "Hit" then
                            return CFrame.new(hitPos)
                        end
                    elseif self == Mouse and key == "UnitRay" then
                        local origin = Camera.CFrame.Position
                        local direction = (hitPos - origin).Unit
                        return Ray.new(origin, direction)
                    end
                end
            end
        end
    end
    return oldIndex(self, key)
end)
