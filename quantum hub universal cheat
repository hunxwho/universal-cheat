local function IsVisible(targetPart)
    if not QuantumConfig.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result == nil or targetPart.Parent:IsAncestorOf(result.Instance)
end

local SkeletonConnections = {
    {"Head", "UpperTorso"}, {"Head", "Torso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local BoxEdges = {
    {1, 2}, {2, 3}, {3, 4}, {4, 1}, -- Top face
    {5, 6}, {6, 7}, {7, 8}, {8, 5}, -- Bottom face
    {1, 5}, {2, 6}, {3, 7}, {4, 8}  -- Connecting pillars
}

local function CreateESPData(player)
    if ESP_Objects[player] then return end
    local esp = { 
        Name = Drawing.new("Text"), 
        Tracer = Drawing.new("Line"),
        BoxOutlines = {},
        BoxLines = {},
        BoneOutlines = {},
        Bones = {}
    }
    
    esp.Name.Size = 16 
    esp.Name.Center = true 
    esp.Name.Outline = true
    esp.Tracer.Thickness = 1.5
    
    -- Create 12 lines for the 3D Box
    for i = 1, 12 do
        local bOut = Drawing.new("Line")
        bOut.Thickness = 3
        bOut.Color = Color3.new(0, 0, 0)
        table.insert(esp.BoxOutlines, bOut)
        
        local bLine = Drawing.new("Line")
        bLine.Thickness = 1
        table.insert(esp.BoxLines, bLine)
    end
    
    -- Create lines for Skeleton
    for i = 1, #SkeletonConnections do
        local outline = Drawing.new("Line")
        outline.Thickness = 3
        outline.Color = Color3.new(0, 0, 0)
        table.insert(esp.BoneOutlines, outline)
        
        local line = Drawing.new("Line")
        line.Thickness = 1
        table.insert(esp.Bones, line)
    end
    
    ESP_Objects[player] = esp
end

local function RemoveESPData(player)
    if ESP_Objects[player] then
        ESP_Objects[player].Name:Remove() 
        ESP_Objects[player].Tracer:Remove()
        
        for _, l in pairs(ESP_Objects[player].BoxOutlines) do l:Remove() end
        for _, l in pairs(ESP_Objects[player].BoxLines) do l:Remove() end
        for _, l in pairs(ESP_Objects[player].BoneOutlines) do l:Remove() end
        for _, l in pairs(ESP_Objects[player].Bones) do l:Remove() end
        
        ESP_Objects[player] = nil
    end
end

