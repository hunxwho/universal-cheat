local lastUpdate = tick()
local lastFrameTime = tick()
local lastTrigger = 0
local frames = 0

TrackConnection(RunService.RenderStepped:Connect(function()
    if IsUnloaded then return end
    pcall(function()
        local mousePos = UserInputService:GetMouseLocation()
        local currentTime = tick()
        local dt = math.clamp(currentTime - lastFrameTime, 0.001, 0.2)
        lastFrameTime = currentTime
        frames = frames + 1
        
        if currentTime - lastUpdate >= 0.5 then
            FPSLabel.Text = "FPS: " .. math.floor(frames / (currentTime - lastUpdate))
            local ok, result = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
            PingLabel.Text = "Ping: " .. (ok and result or "N/A")
            frames = 0
            lastUpdate = currentTime
        end
        
        if QuantumConfig.ShowFOV then
            FOVCircle.Visible = true 
            FOVCircle.Radius = QuantumConfig.FOVRadius 
            FOVCircle.Position = mousePos 
            FOVCircle.Color = Themes[QuantumConfig.Theme]
            FOVCircle.Filled = QuantumConfig.FilledFOV
            FOVCircle.Transparency = QuantumConfig.FilledFOV and 0.18 or 1
        else
            FOVCircle.Visible = false
        end

        if QuantumConfig.CustomCameraFOV then
            Camera.FieldOfView = QuantumConfig.CameraFOV
        end

        local lChar = LocalPlayer.Character
        local lHum = lChar and GetCharacterHumanoid(lChar)
        local lRoot = lChar and GetCharacterRoot(lChar)
        if lHum then
            if QuantumConfig.CustomWalkSpeed then
                lHum.WalkSpeed = QuantumConfig.WalkSpeed
            end
            if QuantumConfig.CustomJumpPower then
                lHum.UseJumpPower = true
                lHum.JumpPower = QuantumConfig.JumpPower
            end
        end

        if lRoot then
            if QuantumConfig.SpinBot then
                lRoot.CFrame = lRoot.CFrame * CFrame.Angles(0, math.rad(QuantumConfig.SpinSpeed), 0)
            end

            if QuantumConfig.Fly and not UserInputService:GetFocusedTextBox() then
                local moveDir = Vector3.zero
                local camCF = Camera.CFrame
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    moveDir = moveDir - Vector3.new(0, 1, 0)
                end
                lRoot.AssemblyLinearVelocity = Vector3.zero
                if moveDir.Magnitude > 0 then
                    lRoot.CFrame = lRoot.CFrame + (moveDir.Unit * QuantumConfig.FlySpeed * dt)
                end
            end
        end

        local activeESPColor = QuantumConfig.RainbowESP
            and Color3.fromHSV((currentTime * 0.22) % 1, 0.9, 1)
            or (QuantumConfig.ESP_Color or Color3.fromRGB(255, 45, 85))

        local tracerStartPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        if QuantumConfig.TracerOrigin == "Center" then
            tracerStartPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        elseif QuantumConfig.TracerOrigin == "Mouse" then
            tracerStartPos = mousePos
        end

        local closestTarget = nil
        local shortestDistance = QuantumConfig.FOVRadius
        local closestBehindWall = nil
        local shortestBehindWallDist = QuantumConfig.FOVRadius

        for model, entityData in pairs(ActiveEntities) do
            local esp = CreateESPData(model)

            if IsAliveAndValid(model) and CheckTeam(entityData) and (not entityData.IsBot or QuantumConfig.IncludeBots) then
                local hrp = GetCharacterRoot(model)
                local head = GetCharacterHead(model)

                if hrp and head then
                    UpdateCharacterHitbox(model, QuantumConfig.HitboxExpander, activeESPColor)

                    if QuantumConfig.ChamsESP then
                        local hl = model:FindFirstChild("QuantumChams")
                        if not hl then 
                            hl = Instance.new("Highlight") 
                            hl.Name = "QuantumChams" 
                            hl.Parent = model 
                        end
                        hl.FillColor = activeESPColor
                        hl.OutlineColor = activeESPColor
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0.1
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Enabled = true
                    else
                        local hl = model:FindFirstChild("QuantumChams")
                        if hl then hl.Enabled = false end
                    end

                    local aimPart = model:FindFirstChild(QuantumConfig.TargetPart) or head or hrp
                    local aimScreenPos, aimOnScreen = Camera:WorldToViewportPoint(aimPart.Position)
                    if aimOnScreen then
                        local cursorDist = (Vector2.new(aimScreenPos.X, aimScreenPos.Y) - mousePos).Magnitude
                        if cursorDist <= QuantumConfig.FOVRadius then
                            local needVisCheck = QuantumConfig.WallCheck or QuantumConfig.PrioritizeBehindWalls
                            local visible = (not needVisCheck) or IsVisible(aimPart, model)

                            if QuantumConfig.PrioritizeBehindWalls then
                                if not visible and cursorDist < shortestBehindWallDist then
                                    closestBehindWall = model
                                    shortestBehindWallDist = cursorDist
                                elseif visible and cursorDist < shortestDistance then
                                    closestTarget = model
                                    shortestDistance = cursorDist
                                end
                            else
                                if (not QuantumConfig.WallCheck or visible) and cursorDist < shortestDistance then
                                    closestTarget = model
                                    shortestDistance = cursorDist
                                end
                            end
                        end
                    end

                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    local distance = (Camera.CFrame.Position - hrp.Position).Magnitude

                    if onScreen and distance <= QuantumConfig.MaxDistance then
                        local headScreen, headVis = Camera:WorldToViewportPoint(head.Position)
                        local topScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.75, 0))
                        local botScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))
                        
                        local boxHeight = math.max(math.abs(botScreen.Y - topScreen.Y), 6)
                        local boxWidth = boxHeight * 0.6
                        local boxPos = Vector2.new(vector.X - boxWidth / 2, topScreen.Y)
                        local boxSize = Vector2.new(boxWidth, boxHeight)

                        if QuantumConfig.BoxESP then
                            esp.Box.Size = boxSize
                            esp.Box.Position = boxPos
                            esp.Box.Color = activeESPColor
                            esp.Box.Visible = true
                        else
                            esp.Box.Visible = false
                        end

                        if QuantumConfig.HeadDotESP and headVis then
                            esp.HeadDot.Position = Vector2.new(headScreen.X, headScreen.Y)
                            esp.HeadDot.Radius = math.clamp(boxWidth * 0.18, 2.5, 10)
                            esp.HeadDot.Color = activeESPColor
                            esp.HeadDot.Visible = true
                        else
                            esp.HeadDot.Visible = false
                        end

                        local curHp, maxHp = GetEntityHealthAndMax(model)
                        if QuantumConfig.HealthESP and maxHp > 0 then
                            local hpRatio = math.clamp(curHp / maxHp, 0, 1)
                            local barX = boxPos.X - 5
                            local barTopY = boxPos.Y
                            local barBotY = boxPos.Y + boxHeight
                            local fillTopY = barBotY - (boxHeight * hpRatio)

                            esp.HealthBG.From = Vector2.new(barX, barTopY - 1)
                            esp.HealthBG.To = Vector2.new(barX, barBotY + 1)
                            esp.HealthBG.Visible = true

                            esp.HealthBar.From = Vector2.new(barX, barBotY)
                            esp.HealthBar.To = Vector2.new(barX, fillTopY)
                            esp.HealthBar.Color = Color3.fromHSV(hpRatio * 0.33, 0.9, 1)
                            esp.HealthBar.Visible = true
                        else
                            esp.HealthBG.Visible = false
                            esp.HealthBar.Visible = false
                        end
                        
                        if QuantumConfig.NameESP then
                            local prefix = entityData.IsBot and "[AI/BOT] " or ""
                            esp.Name.Position = Vector2.new(vector.X, topScreen.Y - 17)
                            esp.Name.Text = string.format("%s%s [%dm]", prefix, entityData.Name, math.floor(distance))
                            esp.Name.Color = activeESPColor
                            esp.Name.Visible = true
                        else 
                            esp.Name.Visible = false 
                        end
                        
                        if QuantumConfig.Tracers then
                            esp.Tracer.From = tracerStartPos
                            esp.Tracer.To = Vector2.new(vector.X, botScreen.Y)
                            esp.Tracer.Color = activeESPColor
                            esp.Tracer.Visible = true
                        else 
                            esp.Tracer.Visible = false 
                        end
                        
                        if QuantumConfig.SkeletonESP then
                            if model:FindFirstChild("UpperTorso") then
                                for i = 1, #R15Skeleton do
                                    local conn = R15Skeleton[i]
                                    local part1, part2 = model:FindFirstChild(conn[1]), model:FindFirstChild(conn[2])
                                    if part1 and part2 then
                                        local pos1, vis1 = Camera:WorldToViewportPoint(part1.Position)
                                        local pos2, vis2 = Camera:WorldToViewportPoint(part2.Position)
                                        if vis1 and vis2 then
                                            esp.Bones[i].From = Vector2.new(pos1.X, pos1.Y)
                                            esp.Bones[i].To = Vector2.new(pos2.X, pos2.Y)
                                            esp.Bones[i].Color = activeESPColor
                                            esp.Bones[i].Visible = true
                                        else
                                            esp.Bones[i].Visible = false
                                        end
                                    else
                                        esp.Bones[i].Visible = false
                                    end
                                end
                            else
                                local r6Joints = GetR6SkeletonPoints(model)
                                for i = 1, #R15Skeleton do
                                    local joint = r6Joints[i]
                                    if joint then
                                        local pos1, vis1 = Camera:WorldToViewportPoint(joint[1])
                                        local pos2, vis2 = Camera:WorldToViewportPoint(joint[2])
                                        if vis1 and vis2 then
                                            esp.Bones[i].From = Vector2.new(pos1.X, pos1.Y)
                                            esp.Bones[i].To = Vector2.new(pos2.X, pos2.Y)
                                            esp.Bones[i].Color = activeESPColor
                                            esp.Bones[i].Visible = true
                                        else
                                            esp.Bones[i].Visible = false
                                        end
                                    else
                                        esp.Bones[i].Visible = false
                                    end
                                end
                            end
                        else
                            for i = 1, #esp.Bones do
                                esp.Bones[i].Visible = false
                            end
                        end
                    else
                        HideESP(esp)
                    end
                else
                    HideESP(esp)
                end
            else
                RestoreCharacterHitboxes(model)
                local hl = model and model:FindFirstChild("QuantumChams")
                if hl then hl.Enabled = false end
                HideESP(esp)
            end
        end

        if QuantumConfig.PrioritizeBehindWalls and closestBehindWall then
            CachedBestTarget = closestBehindWall
        else
            CachedBestTarget = closestTarget
        end

        if CachedBestTarget and IsAliveAndValid(CachedBestTarget) then
            local ent = ActiveEntities[CachedBestTarget]
            local tag = (ent and ent.IsBot) and "[BOT] " or ""
            TargetStatusLabel.Text = "Locked: " .. tag .. (ent and ent.Name or CachedBestTarget.Name)
            local tPart = GetTargetPart(CachedBestTarget)
            if QuantumConfig.ShowTargetLine and (QuantumConfig.Aimbot or QuantumConfig.SilentAim) and tPart then
                local tScreen, tVis = Camera:WorldToViewportPoint(GetPredictedPosition(tPart))
                if tVis then
                    local tVec = Vector2.new(tScreen.X, tScreen.Y)
                    TargetSnapLine.From = mousePos
                    TargetSnapLine.To = tVec
                    TargetSnapLine.Color = Themes[QuantumConfig.Theme]
                    TargetSnapLine.Visible = true

                    TargetLockRing.Position = tVec
                    TargetLockRing.Color = Themes[QuantumConfig.Theme]
                    TargetLockRing.Visible = true
                else
                    TargetSnapLine.Visible = false
                    TargetLockRing.Visible = false
                end
            else
                TargetSnapLine.Visible = false
                TargetLockRing.Visible = false
            end
        else
            TargetStatusLabel.Text = "Locked: None"
            TargetSnapLine.Visible = false
            TargetLockRing.Visible = false
        end

        if QuantumConfig.Aimbot and IsAimbotKeyDown() then
            local targetChar = CachedBestTarget
            if targetChar and IsAliveAndValid(targetChar) then
                local targetPart = targetChar:FindFirstChild(QuantumConfig.TargetPart) or GetCharacterHead(targetChar)
                if targetPart then
                    local aimPos = GetPredictedPosition(targetPart)
                    local cameraCFrame = Camera.CFrame
                    local newLookVector = (aimPos - cameraCFrame.Position).Unit
                    local targetCFrame = CFrame.new(cameraCFrame.Position, cameraCFrame.Position + newLookVector)
                    Camera.CFrame = cameraCFrame:Lerp(targetCFrame, math.clamp(QuantumConfig.Smoothness / 100, 0.01, 1))
                end
            end
        end

        if (QuantumConfig.TriggerBot or QuantumConfig.TriggerWithSilentAim) and (currentTime - lastTrigger >= QuantumConfig.TriggerDelay) then
            local hitEntity = GetTriggerBotTarget(mousePos)
            if hitEntity then
                lastTrigger = currentTime
                ExecuteTriggerShot(mousePos)
            end
        end
    end)
