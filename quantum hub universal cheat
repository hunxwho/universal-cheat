    if lArm then
        local lShoulder = (torso.CFrame * CFrame.new(-1.5, 0.8, 0)).Position
        local lHand = (lArm.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {neck, lShoulder})
        table.insert(joints, {lShoulder, lHand})
    end
    if rArm then
        local rShoulder = (torso.CFrame * CFrame.new(1.5, 0.8, 0)).Position
        local rHand = (rArm.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {neck, rShoulder})
        table.insert(joints, {rShoulder, rHand})
    end
    if lLeg then
        local lHip = (torso.CFrame * CFrame.new(-0.5, -1, 0)).Position
        local lFoot = (lLeg.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {pelvis, lHip})
        table.insert(joints, {lHip, lFoot})
    end
    if rLeg then
        local rHip = (torso.CFrame * CFrame.new(0.5, -1, 0)).Position
        local rFoot = (rLeg.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {pelvis, rHip})
        table.insert(joints, {rHip, rFoot})
    end

    return joints
end

local function CreateESPData(model)
    if ESP_Objects[model] then return ESP_Objects[model] end
    local esp = { 
        Name = Drawing.new("Text"), 
        Tracer = Drawing.new("Line"),
        Box = Drawing.new("Square"),
        HeadDot = Drawing.new("Circle"),
        HealthBG = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        Bones = {}
    }
    esp.Name.Size = 14 
    esp.Name.Center = true 
    esp.Name.Outline = true
    esp.Name.OutlineColor = Color3.fromRGB(0, 0, 0)
    esp.Name.Color = QuantumConfig.ESP_Color
    esp.Name.Transparency = 1
    esp.Name.Visible = false

    esp.Tracer.Thickness = 1.6
    esp.Tracer.Color = QuantumConfig.ESP_Color
    esp.Tracer.Transparency = 1
    esp.Tracer.Visible = false

    esp.Box.Thickness = 1.8
    esp.Box.Filled = false
    esp.Box.Color = QuantumConfig.ESP_Color
    esp.Box.Transparency = 1
    esp.Box.Visible = false

    esp.HeadDot.Thickness = 1.5
    esp.HeadDot.NumSides = 20
    esp.HeadDot.Filled = false
    esp.HeadDot.Color = QuantumConfig.ESP_Color
    esp.HeadDot.Transparency = 1
    esp.HeadDot.Visible = false

    esp.HealthBG.Thickness = 4
    esp.HealthBG.Color = Color3.fromRGB(15, 15, 15)
    esp.HealthBG.Transparency = 1
    esp.HealthBG.Visible = false

    esp.HealthBar.Thickness = 2
    esp.HealthBar.Transparency = 1
    esp.HealthBar.Visible = false
    
    for i = 1, #R15Skeleton do
        local line = Drawing.new("Line") 
        line.Thickness = 1.8
        line.Color = QuantumConfig.ESP_Color
        line.Transparency = 1
        line.Visible = false
        table.insert(esp.Bones, line)
    end
    ESP_Objects[model] = esp
    return esp
end

local function HideESP(esp)
    if not esp then return end
    esp.Box.Visible = false
    esp.Name.Visible = false
    esp.Tracer.Visible = false
    esp.HeadDot.Visible = false
    esp.HealthBG.Visible = false
    esp.HealthBar.Visible = false
    for i = 1, #esp.Bones do
        esp.Bones[i].Visible = false
    end
end

local function RemoveESPData(model)
    local esp = ESP_Objects[model]
    if esp then
        pcall(function()
            esp.Name:Remove() 
            esp.Tracer:Remove()
            esp.Box:Remove()
            esp.HeadDot:Remove()
            esp.HealthBG:Remove()
            esp.HealthBar:Remove()
            for _, l in ipairs(esp.Bones) do l:Remove() end
        end)
        ESP_Objects[model] = nil
    end
end

local function RefreshActiveEntities()
    local seenModels = {}
    local playerCount = 0
    local botCount = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and IsAliveAndValid(player.Character) then
            local char = player.Character
            seenModels[char] = true
            playerCount = playerCount + 1
            ActiveEntities[char] = {
                Model = char,
                Player = player,
                IsBot = false,
                Name = player.DisplayName or player.Name
            }
        end
    end

    if QuantumConfig.IncludeBots then
        for botModel, _ in pairs(DiscoveredBotModels) do
            if not botModel or not botModel.Parent then
                DiscoveredBotModels[botModel] = nil
            elseif not seenModels[botModel] and botModel ~= LocalPlayer.Character then
                local ownerPlayer = Players:GetPlayerFromCharacter(botModel)
                if not ownerPlayer and IsAliveAndValid(botModel) then
                    seenModels[botModel] = true
                    botCount = botCount + 1
                    local hum = GetCharacterHumanoid(botModel)
                    local displayName = (hum and hum.DisplayName ~= "" and hum.DisplayName) or botModel.Name
                    ActiveEntities[botModel] = {
                        Model = botModel,
                        Player = nil,
                        IsBot = true,
                        Name = displayName
                    }
                end
            end
        end
    end

    for model, _ in pairs(ActiveEntities) do
        if not seenModels[model] or not IsAliveAndValid(model) then
            RestoreCharacterHitboxes(model)
            local hl = model and model:FindFirstChild("QuantumChams")
            if hl then hl.Enabled = false end
            RemoveESPData(model)
            ActiveEntities[model] = nil
        end
    end

    EntitiesLabel.Text = string.format("Players: %d | Bots: %d", playerCount, botCount)
end

task.spawn(function()
    while not IsUnloaded do
        pcall(RefreshActiveEntities)
        task.wait(0.25)
    end
end)

local function GetTargetPart(char)
    if not IsAliveAndValid(char) then return nil end
    local mode = QuantumConfig.SilentAimPart
    if mode == "Random" then
        local validParts = {}
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                table.insert(validParts, p)
            end
        end
        if #validParts > 0 then
            return validParts[math.random(1, #validParts)]
        end
        return GetCharacterHead(char) or GetCharacterRoot(char)
    elseif mode == "Closest" then
        local closestPart = nil
        local shortestDist = math.huge
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") then
                local pt, onScreen = Camera:WorldToViewportPoint(p.Position)
                if onScreen then
                    local dist = (Vector2.new(pt.X, pt.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = p
                    end
                end
            end
        end
        return closestPart or GetCharacterHead(char) or GetCharacterRoot(char)
    else
        return char:FindFirstChild(mode) or GetCharacterHead(char) or GetCharacterRoot(char)
    end
end

local function GetPredictedPosition(targetPart)
    if not targetPart then return Vector3.new(0, 0, 0) end
    if not QuantumConfig.Prediction then return targetPart.Position end
    local vel = targetPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    return targetPart.Position + (vel * QuantumConfig.PredictionAmount)
end

local function FindEntityFromDescendant(inst)
    if not inst then return nil end
    for model, entityData in pairs(ActiveEntities) do
        if model == inst or model:IsAncestorOf(inst) then
            return entityData
        end
    end
    return nil
end

local function IsAimbotKeyDown()
    local key = QuantumConfig.AimbotKey
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.UserInputType then
            return UserInputService:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            return UserInputService:IsKeyDown(key)
        end
    end
    return false
end

local function GetTriggerBotTarget(mousePos)
    if QuantumConfig.TriggerWithSilentAim and QuantumConfig.SilentAim and CachedBestTarget and IsAliveAndValid(CachedBestTarget) then
        local ent = ActiveEntities[CachedBestTarget]
        if ent and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    if Mouse.Target then
        local ent = FindEntityFromDescendant(Mouse.Target)
        if ent and IsAliveAndValid(ent.Model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true

    local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2500, rayParams)
    if rayResult and rayResult.Instance then
        local ent = FindEntityFromDescendant(rayResult.Instance)
        if ent and IsAliveAndValid(ent.Model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    local camResult = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 2500, rayParams)
    if camResult and camResult.Instance then
        local ent = FindEntityFromDescendant(camResult.Instance)
        if ent and IsAliveAndValid(ent.Model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    for model, ent in pairs(ActiveEntities) do
        if IsAliveAndValid(model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            local head = GetCharacterHead(model)
            local hrp = GetCharacterRoot(model)
            if head and hrp then
                local hPos, hVis = Camera:WorldToViewportPoint(head.Position)
                local rPos, rVis = Camera:WorldToViewportPoint(hrp.Position)
                if hVis and rVis then
                    local height = math.abs(rPos.Y - hPos.Y) * 2.1
                    local width = math.max(height * 0.55, 18)
                    local centerX, centerY = rPos.X, (hPos.Y + rPos.Y) / 2
                    if math.abs(mousePos.X - centerX) <= width / 2 and math.abs(mousePos.Y - centerY) <= height / 2 then
                        if not QuantumConfig.WallCheck or IsVisible(head, model) or IsVisible(hrp, model) then
                            return ent
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function ExecuteTriggerShot(mousePos)
    if IsFiringTrigger then return end
    if QuantumConfig.MenuOpen and MainFrame.Visible then
        local mPos = MainFrame.AbsolutePosition
        local mSize = MainFrame.AbsoluteSize
        if mousePos.X >= mPos.X and mousePos.X <= mPos.X + mSize.X and mousePos.Y >= mPos.Y and mousePos.Y <= mPos.Y + mSize.Y then
            return
        end
    end

    IsFiringTrigger = true
    task.spawn(function()
        local fired = false

        if type(mouse1press) == "function" and type(mouse1release) == "function" then
            pcall(mouse1press)
            task.wait(0.03)
            pcall(mouse1release)
            fired = true
        elseif type(mouse1click) == "function" then
            pcall(mouse1click)
            fired = true
        end

        if not fired and VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 1)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 1)
                fired = true
            end)
        end

        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end

        IsFiringTrigger = false
    end)
end

