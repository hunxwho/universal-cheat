local function CreateTab(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, 0, 0, 35)
    TabButton.BackgroundColor3 = ThemeColors.Sidebar
    TabButton.Text = name
    TabButton.TextColor3 = ThemeColors.TextGray
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.TextSize = 14
    AddCorner(TabButton, 8)
    TabButton.Parent = Sidebar
    
    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 3, 0, 0)
    Indicator.Position = UDim2.new(0, 0, 0.5, 0)
    Indicator.BackgroundColor3 = Themes[QuantumConfig.Theme]
    Indicator.BorderSizePixel = 0
    AddCorner(Indicator, 2)
    Indicator.Parent = TabButton
    table.insert(ThemeElements, {inst = Indicator, prop = "BackgroundColor3"})
    
    local TabFrame = Instance.new("ScrollingFrame")
    TabFrame.Size = UDim2.new(1, 0, 1, -10)
    TabFrame.Position = UDim2.new(0, 0, 0, 10)
    TabFrame.BackgroundTransparency = 1
    TabFrame.BorderSizePixel = 0
    TabFrame.ScrollBarThickness = 2
    TabFrame.ScrollBarImageColor3 = ThemeColors.TextGray
    TabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabFrame.Visible = false
    TabFrame.Parent = Content
    
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = TabFrame
    
    local Padding = Instance.new("UIPadding")
    Padding.PaddingRight = UDim.new(0, 10)
    Padding.Parent = TabFrame
    
    Tabs[name] = {Button = TabButton, Frame = TabFrame, Indicator = Indicator}
    table.insert(ThemeElements, {
        inst = TabButton, 
        prop = "TextColor3", 
        condition = function() return currentTabName == name end
    })
    
    TabButton.MouseButton1Click:Connect(function()
        currentTabName = name
        for tName, tab in pairs(Tabs) do
            local isSelected = (tName == name)
            tab.Frame.Visible = isSelected
            
            TweenService:Create(tab.Button, TweenInfo.new(0.3), {
                TextColor3 = isSelected and Themes[QuantumConfig.Theme] or ThemeColors.TextGray,
                BackgroundColor3 = isSelected and ThemeColors.ElementBG or ThemeColors.Sidebar
            }):Play()
            
            TweenService:Create(tab.Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = isSelected and UDim2.new(0, 3, 0.6, 0) or UDim2.new(0, 3, 0, 0),
                Position = isSelected and UDim2.new(0, 0, 0.2, 0) or UDim2.new(0, 0, 0.5, 0)
            }):Play()
        end
    end)
    return TabFrame
end

