-- STRICT CLOSEST ENEMY SCANNER WITH WALL PRIORITIZATION
local function GetClosestTargetToCursor()
    local closestTarget = nil
    local shortestDistance = QuantumConfig.FOVRadius
    local closestBehindWall = nil
    local shortestBehindWallDist = QuantumConfig.FOVRadius
    local mousePos = UserInputService:GetMouseLocation()
    
    local candidates = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAliveAndValid(player.Character) and CheckTeam(player) then
            table.insert(candidates, player.Character)
        end
    end
    
    if QuantumConfig.UniversalTargeting then
        local searchFolders = {workspace}
        if workspace:FindFirstChild("Players") then table.insert(searchFolders, workspace.Players) end
        if workspace:FindFirstChild("Characters") then table.insert(searchFolders, workspace.Characters) end
        
        for _, folder in pairs(searchFolders) do
            for _, model in pairs(folder:GetChildren()) do
                if model:IsA("Model") and model ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(model) then
                    if IsAliveAndValid(model) then
                        table.insert(candidates, model)
                    end
                end
            end
        end
    end
    
    for _, char in ipairs(candidates) do
        local checkPart = char:FindFirstChild(QuantumConfig.TargetPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if checkPart then
            local targetPos, onScreen = Camera:WorldToViewportPoint(checkPart.Position)
            if onScreen then
                local magnitude = (Vector2.new(targetPos.X, targetPos.Y) - mousePos).Magnitude
                local visible = IsVisible(checkPart)
                
                if QuantumConfig.PrioritizeBehindWalls then
                    if not visible and magnitude < shortestBehindWallDist then
                        closestBehindWall = char
                        shortestBehindWallDist = magnitude
                    elseif visible and magnitude < shortestDistance then
                        closestTarget = char
                        shortestDistance = magnitude
                    end
                else
                    if (not QuantumConfig.WallCheck or visible) and magnitude < shortestDistance then
                        closestTarget = char
                        shortestDistance = magnitude
                    end
                end
            end
        end
    end
    
    if QuantumConfig.PrioritizeBehindWalls and closestBehindWall then
        return closestBehindWall
    end
    return closestTarget
end

