local function UpdateWorld()
    local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
    
    -- Reset base lighting
    Lighting.ClockTime = 14
    Lighting.Brightness = QuantumConfig.Brightness
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.FogEnd = 100000
    
    sky.SunAngularSize = 14
    sky.MoonAngularSize = QuantumConfig.MoonSize
    sky.StarCount = 3000
    
    -- CRITICAL FIX: CLEAR SKYBOX TEXTURES TO PREVENT THE BOX EFFECT
    sky.SkyboxBk = ""
    sky.SkyboxDn = ""
    sky.SkyboxFt = ""
    sky.SkyboxLf = ""
    sky.SkyboxRt = ""
    sky.SkyboxUp = ""

    -- Lowered Density and Haze significantly to allow deep, clear procedural gradients
    atmosphere.Density = 0.1
    atmosphere.Offset = 0.25
    atmosphere.Glare = 0.5
    atmosphere.Haze = 0.1
    atmosphere.Color = Color3.fromRGB(199, 199, 199)
    atmosphere.Decay = Color3.fromRGB(100, 100, 100)
    
    if QuantumConfig.WorldTheme == "Default" then
        Lighting.ClockTime = 14
        atmosphere.Color = Color3.fromRGB(150, 180, 220)
        atmosphere.Decay = Color3.fromRGB(80, 100, 150)
        
    elseif QuantumConfig.WorldTheme == "Midnight" then
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.5
        sky.StarCount = 15000
        
    elseif QuantumConfig.WorldTheme == "Vaporwave" then
        Lighting.ClockTime = 18
        Lighting.Ambient = Color3.fromRGB(200, 80, 255)
        atmosphere.Color = Color3.fromRGB(255, 80, 200)
        atmosphere.Haze = 0.5
        
    elseif QuantumConfig.WorldTheme == "Nuclear" then
        Lighting.ClockTime = 12
        Lighting.Ambient = Color3.fromRGB(80, 255, 80)
        atmosphere.Color = Color3.fromRGB(120, 255, 120)
        atmosphere.Haze = 0.8
        
    elseif QuantumConfig.WorldTheme == "Blood Moon" then
        Lighting.ClockTime = 2
        Lighting.Ambient = Color3.fromRGB(255, 40, 40)
        atmosphere.Color = Color3.fromRGB(200, 20, 20)
        
    elseif QuantumConfig.WorldTheme == "Quantum Space" then
        Lighting.ClockTime = 0
        Lighting.Brightness = 2
        atmosphere.Density = 0
        atmosphere.Haze = 0
        sky.StarCount = 20000
        
    elseif QuantumConfig.WorldTheme == "Aurora Borealis" then
        Lighting.ClockTime = 1
        atmosphere.Color = Color3.fromRGB(60, 255, 220)
        sky.StarCount = 12000
        
    elseif QuantumConfig.WorldTheme == "Eternal Sunset" then
        Lighting.ClockTime = 17.8
        atmosphere.Color = Color3.fromRGB(255, 120, 60)
        atmosphere.Haze = 0.3
        
    elseif QuantumConfig.WorldTheme == "Thunderstorm" then
        Lighting.ClockTime = 12
        Lighting.Brightness = 0.3
        atmosphere.Density = 0.5
        atmosphere.Haze = 2
        atmosphere.Color = Color3.fromRGB(50, 55, 65)
        
    elseif QuantumConfig.WorldTheme == "Cosmic Nebula" then
        Lighting.ClockTime = 0
        atmosphere.Color = Color3.fromRGB(140, 40, 255)
        sky.StarCount = 15000
        
    elseif QuantumConfig.WorldTheme == "Inferno Sky" then
        Lighting.ClockTime = 15
        Lighting.Ambient = Color3.fromRGB(255, 100, 40)
        atmosphere.Color = Color3.fromRGB(255, 80, 20)
        atmosphere.Haze = 0.5
        
    elseif QuantumConfig.WorldTheme == "Paradise" then
        Lighting.ClockTime = 11
        Lighting.Brightness = 3.6
        atmosphere.Color = Color3.fromRGB(100, 200, 255)
        
    elseif QuantumConfig.WorldTheme == "Cyberpunk City" then
        Lighting.ClockTime = 2
        Lighting.Ambient = Color3.fromRGB(255, 0, 150)
        atmosphere.Color = Color3.fromRGB(0, 255, 255)
        atmosphere.Haze = 0.4
        
    elseif QuantumConfig.WorldTheme == "Deep Space" then
        Lighting.ClockTime = 0
        Lighting.Brightness = 3
        atmosphere.Density = 0
        atmosphere.Haze = 0
        sky.StarCount = 25000
        
    elseif QuantumConfig.WorldTheme == "Synthwave Retro" then
        Lighting.ClockTime = 18
        Lighting.Brightness = 1.8
        atmosphere.Color = Color3.fromRGB(255, 0, 100)
        atmosphere.Haze = 0.3
    end
end

