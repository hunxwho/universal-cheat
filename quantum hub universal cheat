    SwitchKnob.Parent = SwitchBG
    
    table.insert(ThemeElements, {
        inst = SwitchBG, 
        prop = "BackgroundColor3", 
        condition = function() return QuantumConfig[configKey] end
    })
    
    Frame.MouseEnter:Connect(function() TweenService:Create(Frame, TweenInfo.new(0.2), {BackgroundColor3 = ThemeColors.ElementHover}):Play() end)
    Frame.MouseLeave:Connect(function() TweenService:Create(Frame, TweenInfo.new(0.2), {BackgroundColor3 = ThemeColors.ElementBG}):Play() end)
    
    local isAnimating = false
    Frame.MouseButton1Click:Connect(function()
        if isAnimating then return end
        isAnimating = true
        QuantumConfig[configKey] = not QuantumConfig[configKey]
        local state = QuantumConfig[configKey]
        
        TweenService:Create(Frame, TweenInfo.new(0.1), {Size = UDim2.new(0.98, 0, 0, 40)}):Play()
        TweenService:Create(SwitchKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 24, 0, 16),
            Position = state and UDim2.new(0, 2, 0.5, -8) or UDim2.new(1, -26, 0.5, -8)
        }):Play()
        
        TweenService:Create(SwitchBG, TweenInfo.new(0.35), {
            BackgroundColor3 = state and Themes[QuantumConfig.Theme] or Color3.fromRGB(50, 50, 55)
        }):Play()
        task.wait(0.1)
        TweenService:Create(Frame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 42)}):Play()
        TweenService:Create(SwitchKnob, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 16, 0, 16),
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        }):Play()
        task.wait(0.2)
        isAnimating = false
    end)
end

