RunService.RenderStepped:Connect(function()
    pcall(function()
        local mousePos = UserInputService:GetMouseLocation()
        local currentTime = tick()
        frames = frames + 1
        
        if currentTime - lastUpdate >= 0.5 then
            FPSLabel.Text = "FPS: " .. math.floor(frames / (currentTime - lastUpdate))
            local success, result = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
            PingLabel.Text = "Ping: " .. (success and result or "N/A")
            frames = 0
            lastUpdate = currentTime
        end
        
