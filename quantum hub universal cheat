local function GetClosestPlayerToCursor()
    local closestPlayer = nil
    local shortestDistance = QuantumConfig.FOVRadius
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(QuantumConfig.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPos, onScreen = Camera:WorldToViewportPoint(player.Character[QuantumConfig.TargetPart].Position)
            if onScreen and IsVisible(player.Character[QuantumConfig.TargetPart]) then
                local magnitude = (Vector2.new(targetPos.X, targetPos.Y) - mousePos).Magnitude
                if magnitude < shortestDistance then
                    closestPlayer = player
                    shortestDistance = magnitude
                end
            end
        end
    end
    return closestPlayer
end

local lastUpdate = tick()
local lastTrigger = tick()
local frames = 0

RunService.RenderStepped:Connect(function()
    pcall(function() -- Added safety wrapper for universal execution
        local mousePos = UserInputService:GetMouseLocation()
        local currentTime = tick()
        frames = frames + 1
        
        if currentTime - lastUpdate >= 0.5 then
            FPSLabel.Text = "FPS: " .. math.floor(frames / (currentTime - lastUpdate))
            local success, result = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
            PingLabel.Text = "Ping: " .. (success and result or "N/A")
            frames = 0
            lastUpdate = currentTime
        end
        
        if QuantumConfig.ShowFOV then
            FOVCircle.Visible = true
            FOVCircle.Radius = QuantumConfig.FOVRadius
            FOVCircle.Position = mousePos
            FOVCircle.Color = Themes[QuantumConfig.Theme]
        else
            FOVCircle.Visible = false
        end
        
        if QuantumConfig.Aimbot and UserInputService:IsMouseButtonPressed(QuantumConfig.AimbotKey) then
            local target = GetClosestPlayerToCursor()
            if target and target.Character then
                local targetPart = target.Character:FindFirstChild(QuantumConfig.TargetPart)
                if targetPart then
                    local cameraCFrame = Camera.CFrame
                    local newLookVector = (targetPart.Position - cameraCFrame.Position).Unit
                    local targetCFrame = CFrame.new(cameraCFrame.Position, cameraCFrame.Position + newLookVector)
                    Camera.CFrame = cameraCFrame:Lerp(targetCFrame, QuantumConfig.Smoothness / 10)
                end
            end
        end
        
        if QuantumConfig.TriggerBot and currentTime - lastTrigger >= QuantumConfig.TriggerDelay then
            local target = Mouse.Target
            if target and target.Parent and target.Parent:FindFirstChild("Humanoid") and target.Parent.Name ~= LocalPlayer.Name then
                if mouse1click then mouse1click() end
                lastTrigger = currentTime
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not ESP_Objects[player] then CreateESPData(player) end
                local esp = ESP_Objects[player]
                
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                    local hrp = player.Character.HumanoidRootPart
                    local head = player.Character:FindFirstChild("Head")
                    
                    if not head then continue end
                    
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                    
                    -- Realistic depth-based dynamic thickness
                    local dynamicThickness = math.clamp(250 / distance, 1, 5)
                    
                    if onScreen and distance <= QuantumConfig.MaxDistance then
                        
                        -- 3D BOX ESP (REALISTIC)
                        if QuantumConfig.BoxESP then
                            local cf, size = player.Character:GetBoundingBox()
                            local sx, sy, sz = (size.X/2) + 0.2, (size.Y/2) + 0.2, (size.Z/2) + 0.2
                            
                            local corners3D = {
                                cf * CFrame.new(sx, sy, sz),
                                cf * CFrame.new(-sx, sy, sz),
                                cf * CFrame.new(-sx, -sy, sz),
                                cf * CFrame.new(sx, -sy, sz),
                                cf * CFrame.new(sx, sy, -sz),
                                cf * CFrame.new(-sx, sy, -sz),
                                cf * CFrame.new(-sx, -sy, -sz),
                                cf * CFrame.new(sx, -sy, -sz)
                            }
                            
                            local corners2D = {}
                            local boxOnScreen = false
                            for i = 1, 8 do
                                local pt, vis = Camera:WorldToViewportPoint(corners3D[i].Position)
                                corners2D[i] = Vector2.new(pt.X, pt.Y)
                                if vis then boxOnScreen = true end
                            end
                            
                            if boxOnScreen then
                                for i, edge in ipairs(BoxEdges) do
                                    esp.BoxOutlines[i].From = corners2D[edge[1]]
                                    esp.BoxOutlines[i].To = corners2D[edge[2]]
                                    esp.BoxOutlines[i].Thickness = dynamicThickness + 1.5
                                    esp.BoxOutlines[i].Visible = true
                                    
                                    esp.BoxLines[i].From = corners2D[edge[1]]
                                    esp.BoxLines[i].To = corners2D[edge[2]]
                                    esp.BoxLines[i].Thickness = dynamicThickness
                                    esp.BoxLines[i].Color = QuantumConfig.ESP_Color
                                    esp.BoxLines[i].Visible = true
                                end
                            else
                                for i = 1, 12 do esp.BoxOutlines[i].Visible = false esp.BoxLines[i].Visible = false end
                            end
                        else
                            for i = 1, 12 do esp.BoxOutlines[i].Visible = false esp.BoxLines[i].Visible = false end
                        end
                        
                        -- Name ESP
                        if QuantumConfig.NameESP then
                            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                            esp.Name.Position = Vector2.new(vector.X, headPos.Y - 20)
                            esp.Name.Text = player.Name .. " [" .. math.floor(distance) .. "s]"
                            esp.Name.Color = QuantumConfig.ESP_Color
                            esp.Name.Visible = true
                        else
                            esp.Name.Visible = false
                        end
                        
                        -- Tracer ESP
                        if QuantumConfig.Tracers then
                            local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(vector.X, legPos.Y)
                            esp.Tracer.Color = QuantumConfig.ESP_Color
                            esp.Tracer.Visible = true
                        else
                            esp.Tracer.Visible = false
                        end
                        
                        -- Skeleton ESP (Realistic with depth thickness)
                        if QuantumConfig.SkeletonESP then
                            for i, connection in ipairs(SkeletonConnections) do
                                local part1 = player.Character:FindFirstChild(connection[1])
                                local part2 = player.Character:FindFirstChild(connection[2])
                                
                                if part1 and part2 then
                                    local pos1, vis1 = Camera:WorldToViewportPoint(part1.Position)
                                    local pos2, vis2 = Camera:WorldToViewportPoint(part2.Position)
                                    
                                    if vis1 or vis2 then
                                        esp.BoneOutlines[i].From = Vector2.new(pos1.X, pos1.Y)
                                        esp.BoneOutlines[i].To = Vector2.new(pos2.X, pos2.Y)
                                        esp.BoneOutlines[i].Thickness = dynamicThickness + 1.5
                                        esp.BoneOutlines[i].Visible = true
                                        
                                        esp.Bones[i].From = Vector2.new(pos1.X, pos1.Y)
                                        esp.Bones[i].To = Vector2.new(pos2.X, pos2.Y)
                                        esp.Bones[i].Thickness = dynamicThickness
                                        esp.Bones[i].Color = QuantumConfig.ESP_Color
                                        esp.Bones[i].Visible = true
                                    else
                                        esp.BoneOutlines[i].Visible = false
                                        esp.Bones[i].Visible = false
                                    end
                                else
                                    esp.BoneOutlines[i].Visible = false
                                    esp.Bones[i].Visible = false
                                end
                            end
                        else
                            for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                            for _, bone in pairs(esp.Bones) do bone.Visible = false end
                        end
                        
                    else
                        for i = 1, 12 do esp.BoxOutlines[i].Visible = false esp.BoxLines[i].Visible = false end
                        esp.Name.Visible = false
                        esp.Tracer.Visible = false
                        for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                        for _, bone in pairs(esp.Bones) do bone.Visible = false end
                    end
                else
                    for i = 1, 12 do esp.BoxOutlines[i].Visible = false esp.BoxLines[i].Visible = false end
                    esp.Name.Visible = false
                    esp.Tracer.Visible = false
                    for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                    for _, bone in pairs(esp.Bones) do bone.Visible = false end
                end
            end
        end
    end)
end)
