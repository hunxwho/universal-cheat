            FOVCircle.Position = mousePos 
            FOVCircle.Color = Themes[QuantumConfig.Theme]
        else
            FOVCircle.Visible = false
        end
        
        if QuantumConfig.Aimbot and UserInputService:IsMouseButtonPressed(QuantumConfig.AimbotKey) then
            local targetChar = GetClosestTargetToCursor()
            if targetChar and IsAliveAndValid(targetChar) then
                local targetPart = targetChar:FindFirstChild(QuantumConfig.TargetPart) or targetChar:FindFirstChild("Head")
                if targetPart then
                    local cameraCFrame = Camera.CFrame
                    local newLookVector = (targetPart.Position - cameraCFrame.Position).Unit
                    local targetCFrame = CFrame.new(cameraCFrame.Position, cameraCFrame.Position + newLookVector)
                    Camera.CFrame = cameraCFrame:Lerp(targetCFrame, QuantumConfig.Smoothness / 100)
                end
            end
        end
        
        if QuantumConfig.TriggerBot and currentTime - lastTrigger >= QuantumConfig.TriggerDelay then
            local target = Mouse.Target
            if target and target.Parent and IsAliveAndValid(target.Parent) and target.Parent.Name ~= LocalPlayer.Name then
                local tPlayer = Players:GetPlayerFromCharacter(target.Parent)
                if CheckTeam(tPlayer or target.Parent) then
                    if mouse1click then mouse1click() end
                    lastTrigger = currentTime
                end
            end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not ESP_Objects[player] then CreateESPData(player) end
                local esp = ESP_Objects[player]
                local char = player.Character
                
                if IsAliveAndValid(char) and CheckTeam(player) then
                    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    local head = char:FindFirstChild("Head")
                    if not hrp or not head then continue end
                    
                    if QuantumConfig.HitboxExpander then
                        hrp.Size = Vector3.new(QuantumConfig.HitboxSize, QuantumConfig.HitboxSize, QuantumConfig.HitboxSize)
                        hrp.Transparency = 0.7
                        hrp.Material = Enum.Material.Neon
                        hrp.Color = QuantumConfig.ESP_Color
                        hrp.CanCollide = false
                    else
                        if hrp.Size.X ~= 2 and hrp.Name == "HumanoidRootPart" then 
                            hrp.Size = Vector3.new(2, 2, 1) 
                            hrp.Transparency = 1 
                        end
                    end
                    
                    if QuantumConfig.ChamsESP then
                        local hl = char:FindFirstChild("QuantumChams")
                        if not hl then 
                            hl = Instance.new("Highlight") 
                            hl.Name = "QuantumChams" 
                            hl.Parent = char 
                        end
                        hl.FillColor = QuantumConfig.ESP_Color
                        hl.OutlineColor = QuantumConfig.ESP_Color
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0.1
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Enabled = true
                    else
                        local hl = char:FindFirstChild("QuantumChams")
                        if hl then hl.Enabled = false end
                    end
                    
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                    local dynamicThickness = math.clamp(250 / distance, 1, 5)
                    
                    if onScreen and distance <= QuantumConfig.MaxDistance then
                        -- 2D BOUNDING BOX ESP (4 Lines)
                        if QuantumConfig.BoxESP then
                            local cf, size = char:GetBoundingBox()
                            local halfX, halfY = (size.X / 2) + 0.5, (size.Y / 2) + 0.5
                            local topPos = Camera:WorldToViewportPoint((cf * CFrame.new(0, halfY, 0)).Position)
                            local botPos = Camera:WorldToViewportPoint((cf * CFrame.new(0, -halfY, 0)).Position)
                            
                            local boxHeight = math.abs(topPos.Y - botPos.Y)
                            local boxWidth = boxHeight * 0.65
                            
                            local topLeft = Vector2.new(topPos.X - boxWidth / 2, topPos.Y)
                            local topRight = Vector2.new(topPos.X + boxWidth / 2, topPos.Y)
                            local botLeft = Vector2.new(botPos.X - boxWidth / 2, botPos.Y)
                            local botRight = Vector2.new(botPos.X + boxWidth / 2, botPos.Y)
                            
                            local lines = {
                                {topLeft, topRight},    -- Top
                                {botLeft, botRight},    -- Bottom
                                {topLeft, botLeft},     -- Left
                                {topRight, botRight}    -- Right
                            }
                            
                            for i = 1, 4 do
                                esp.BoxOutlines[i].From = lines[i][1]
                                esp.BoxOutlines[i].To = lines[i][2]
                                esp.BoxOutlines[i].Thickness = dynamicThickness + 1.5
                                esp.BoxOutlines[i].Visible = true
                                
                                esp.BoxLines[i].From = lines[i][1]
                                esp.BoxLines[i].To = lines[i][2]
                                esp.BoxLines[i].Thickness = dynamicThickness
                                esp.BoxLines[i].Color = QuantumConfig.ESP_Color
                                esp.BoxLines[i].Visible = true
                            end
                        else
                            for i = 1, 4 do 
                                esp.BoxOutlines[i].Visible = false 
                                esp.BoxLines[i].Visible = false 
                            end
                        end
                        
                        -- NAME ESP
                        if QuantumConfig.NameESP then
                            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                            esp.Name.Position = Vector2.new(vector.X, headPos.Y - 20)
                            esp.Name.Text = player.Name .. " [" .. math.floor(distance) .. "m]"
                            esp.Name.Color = QuantumConfig.ESP_Color
                            esp.Name.Visible = true
                        else 
                            esp.Name.Visible = false 
                        end
                        
                        -- TRACERS
                        if QuantumConfig.Tracers then
                            local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(vector.X, legPos.Y)
                            esp.Tracer.Color = QuantumConfig.ESP_Color
                            esp.Tracer.Visible = true
                        else 
                            esp.Tracer.Visible = false 
                        end
                        
                        -- ANATOMICAL SKELETON ESP
                        if QuantumConfig.SkeletonESP then
                            local activeSkeleton = char:FindFirstChild("UpperTorso") and R15Skeleton or R6Skeleton
                            for i = 1, #R15Skeleton do
                                if i <= #activeSkeleton then
                                    local conn = activeSkeleton[i]
                                    local part1, part2 = char:FindFirstChild(conn[1]), char:FindFirstChild(conn[2])
                                    if part1 and part2 then
                                        local pos1, vis1 = Camera:WorldToViewportPoint(part1.Position)
                                        local pos2, vis2 = Camera:WorldToViewportPoint(part2.Position)
                                        if vis1 or vis2 then
                                            esp.BoneOutlines[i].From = Vector2.new(pos1.X, pos1.Y)
                                            esp.BoneOutlines[i].To = Vector2.new(pos2.X, pos2.Y)
                                            esp.BoneOutlines[i].Thickness = dynamicThickness + 1.5
                                            esp.BoneOutlines[i].Visible = true
                                            
                                            esp.Bones[i].From = Vector2.new(pos1.X, pos1.Y)
                                            esp.Bones[i].To = Vector2.new(pos2.X, pos2.Y)
                                            esp.Bones[i].Thickness = dynamicThickness
                                            esp.Bones[i].Color = QuantumConfig.ESP_Color
                                            esp.Bones[i].Visible = true
                                        else
                                            esp.BoneOutlines[i].Visible = false
                                            esp.Bones[i].Visible = false
                                        end
                                    else
                                        esp.BoneOutlines[i].Visible = false
                                        esp.Bones[i].Visible = false
                                    end
                                else
                                    esp.BoneOutlines[i].Visible = false
                                    esp.Bones[i].Visible = false
                                end
                            end
                        else
                            for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                            for _, bone in pairs(esp.Bones) do bone.Visible = false end
                        end
                        
                    else
                        for i = 1, 4 do 
                            esp.BoxOutlines[i].Visible = false 
                            esp.BoxLines[i].Visible = false 
                        end
                        esp.Name.Visible = false
                        esp.Tracer.Visible = false
                        for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                        for _, bone in pairs(esp.Bones) do bone.Visible = false end
                    end
                    
                else
                    if char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Size.X ~= 2 and char.HumanoidRootPart.Name == "HumanoidRootPart" then 
                        char.HumanoidRootPart.Size = Vector3.new(2, 2, 1) 
                        char.HumanoidRootPart.Transparency = 1 
                    end
                    local hl = char and char:FindFirstChild("QuantumChams")
                    if hl then hl.Enabled = false end
                    for i = 1, 4 do 
                        esp.BoxOutlines[i].Visible = false 
                        esp.BoxLines[i].Visible = false 
                    end
                    esp.Name.Visible = false
                    esp.Tracer.Visible = false
                    for _, outline in pairs(esp.BoneOutlines) do outline.Visible = false end
                    for _, bone in pairs(esp.Bones) do bone.Visible = false end
                end
            end
        end
    end)
end)

