local CreatedLightingObjects = {}

local function UpdateWorld()
    if IsUnloaded then return end
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Lighting
        table.insert(CreatedLightingObjects, sky)
    end
    
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Parent = Lighting
        table.insert(CreatedLightingObjects, atmosphere)
    end
    
    local cc = Lighting:FindFirstChild("QuantumColorCorrection")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "QuantumColorCorrection"
        cc.Parent = Lighting
        table.insert(CreatedLightingObjects, cc)
    end
    
    Lighting.ClockTime = 14
    Lighting.Brightness = QuantumConfig.Fullbright and 3.5 or QuantumConfig.Brightness
    Lighting.Ambient = QuantumConfig.Fullbright and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(128, 128, 128)
    Lighting.OutdoorAmbient = QuantumConfig.Fullbright and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(128, 128, 128)
    Lighting.FogEnd = QuantumConfig.NoFog and 9e9 or 100000
    
    sky.SunAngularSize = 14
    sky.MoonAngularSize = QuantumConfig.MoonSize
    sky.StarCount = 3000
    
    cc.TintColor = Color3.fromRGB(255, 255, 255)
    cc.Saturation = 0
    cc.Contrast = 0
    
    atmosphere.Density = QuantumConfig.NoFog and 0 or 0.3
    atmosphere.Offset = 0.25
    atmosphere.Glare = 0.5
    atmosphere.Haze = QuantumConfig.NoFog and 0 or 0.2
    atmosphere.Color = Color3.fromRGB(199, 199, 199)
    atmosphere.Decay = Color3.fromRGB(100, 100, 100)
    
    local theme = QuantumConfig.WorldTheme
    if theme == "Default" then
        Lighting.ClockTime = OriginalLighting.ClockTime
        atmosphere.Color = Color3.fromRGB(150, 180, 220)
        atmosphere.Decay = Color3.fromRGB(80, 100, 150)
    elseif theme == "Midnight" then
        Lighting.ClockTime = 0
        if not QuantumConfig.Fullbright then Lighting.Brightness = 0.5 end
        sky.StarCount = 15000
        atmosphere.Color = Color3.fromRGB(10, 10, 20)
    elseif theme == "Vaporwave" then
        Lighting.ClockTime = 18
        Lighting.Ambient = Color3.fromRGB(200, 80, 255)
        atmosphere.Color = Color3.fromRGB(255, 80, 200)
        atmosphere.Haze = 0.5
        cc.TintColor = Color3.fromRGB(230, 150, 255)
        cc.Saturation = 0.5
    elseif theme == "Nuclear" then
        Lighting.ClockTime = 12
        Lighting.Ambient = Color3.fromRGB(80, 255, 80)
        atmosphere.Color = Color3.fromRGB(120, 255, 120)
        atmosphere.Haze = 0.8
        cc.TintColor = Color3.fromRGB(180, 255, 180)
    elseif theme == "Blood Moon" then
        Lighting.ClockTime = 0
        Lighting.Ambient = Color3.fromRGB(255, 40, 40)
        atmosphere.Color = Color3.fromRGB(200, 20, 20)
        cc.TintColor = Color3.fromRGB(255, 150, 150)
    elseif theme == "Quantum Space" then
        Lighting.ClockTime = 0
        Lighting.Brightness = 1.5
        atmosphere.Density = 0
        atmosphere.Haze = 0
        sky.StarCount = 30000
        cc.TintColor = Color3.fromRGB(180, 180, 255)
        cc.Contrast = 0.2
    elseif theme == "Aurora Borealis" then
        Lighting.ClockTime = 1
        atmosphere.Color = Color3.fromRGB(60, 255, 220)
        sky.StarCount = 12000
        cc.TintColor = Color3.fromRGB(180, 255, 255)
    elseif theme == "Eternal Sunset" then
