    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    if warningTag then
        local WarnBadge = Instance.new("TextLabel")
        WarnBadge.Size = UDim2.new(0, 108, 0, 20)
        WarnBadge.Position = UDim2.new(1, -168, 0.5, -10)
        WarnBadge.BackgroundColor3 = Color3.fromRGB(48, 30, 20)
        WarnBadge.Text = warningTag
        WarnBadge.TextColor3 = ThemeColors.WarningOrange
        WarnBadge.Font = Enum.Font.GothamBold
        WarnBadge.TextSize = 10
        AddCorner(WarnBadge, 6)
        AddStroke(WarnBadge, ThemeColors.WarningOrange, 1)
        WarnBadge.Parent = Frame
    end
    
    local initState = QuantumConfig[configKey]
    local SwitchBG = Instance.new("Frame")
    SwitchBG.Size = UDim2.new(0, 38, 0, 20)
    SwitchBG.Position = UDim2.new(1, -52, 0.5, -10)
    SwitchBG.BackgroundColor3 = initState and (warningTag and ThemeColors.WarningOrange or Themes[QuantumConfig.Theme]) or ThemeColors.ControlBG
    AddCorner(SwitchBG, 10)
    SwitchBG.Parent = Frame
    
    local SwitchKnob = Instance.new("Frame")
    SwitchKnob.Size = UDim2.new(0, 14, 0, 14)
    SwitchKnob.Position = initState and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    SwitchKnob.BackgroundColor3 = initState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 136, 165)
    AddCorner(SwitchKnob, 7)
    SwitchKnob.Parent = SwitchBG
    
    if not warningTag then
        table.insert(ThemeElements, {
            inst = SwitchBG, 
            prop = "BackgroundColor3", 
            condition = function() return QuantumConfig[configKey] end
        })
    end
    
    local function SyncVisualState()
        local state = QuantumConfig[configKey]
        local activeCol = warningTag and ThemeColors.WarningOrange or Themes[QuantumConfig.Theme]
        TweenService:Create(SwitchKnob, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 136, 165)
        }):Play()
        TweenService:Create(SwitchBG, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            BackgroundColor3 = state and activeCol or ThemeColors.ControlBG
        }):Play()
    end
    table.insert(UIControlRefreshers, SyncVisualState)

    TrackConnection(Frame.MouseEnter:Connect(function() 
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = ThemeColors.CardHover}):Play() 
        TweenService:Create(FrameStroke, TweenInfo.new(0.18), {Color = warningTag and ThemeColors.WarningOrange or Themes[QuantumConfig.Theme]}):Play()
    end))
    TrackConnection(Frame.MouseLeave:Connect(function() 
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = ThemeColors.CardBG}):Play() 
        TweenService:Create(FrameStroke, TweenInfo.new(0.18), {Color = defaultBorder}):Play()
    end))
    
    TrackConnection(Frame.MouseButton1Click:Connect(function()
        QuantumConfig[configKey] = not QuantumConfig[configKey]
        SyncVisualState()
        if QuantumConfig[configKey] and warningTag then
            Notify("⚠ Anti-Cheat Warning", name .. " is enabled. High detection risk in strict games!", 3.2, true)
        end
        if configKey == "Fullbright" or configKey == "NoFog" then
            UpdateWorld()
        end
        if callback then task.spawn(callback, QuantumConfig[configKey]) end
    end))
end

local function CreateSlider(parent, name, min, max, configKey, isFloat, callback, warnThreshold, warnText)
    local Frame = Instance.new("Frame")
    Frame.LayoutOrder = GetOrder()
    Frame.Size = UDim2.new(1, 0, 0, 56)
    Frame.BackgroundColor3 = ThemeColors.CardBG
    AddCorner(Frame, 10)
    local FrameStroke = AddStroke(Frame, Color3.fromRGB(36, 40, 58), 1)
    Frame.Parent = parent
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -210, 0, 20)
    Label.Position = UDim2.new(0, 16, 0, 8)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = ThemeColors.TextWhite
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local RiskBadge = nil
    if warnThreshold then
        RiskBadge = Instance.new("TextLabel")
        RiskBadge.Size = UDim2.new(0, 155, 0, 18)
        RiskBadge.Position = UDim2.new(1, -225, 0, 9)
        RiskBadge.BackgroundColor3 = Color3.fromRGB(55, 20, 24)
        RiskBadge.Text = warnText or ("⚠ DETECTABLE >" .. tostring(warnThreshold) .. "%")
        RiskBadge.TextColor3 = ThemeColors.DangerRed
        RiskBadge.Font = Enum.Font.GothamBold
        RiskBadge.TextSize = 10
        AddCorner(RiskBadge, 5)
        AddStroke(RiskBadge, ThemeColors.DangerRed, 1)
        RiskBadge.Visible = (QuantumConfig[configKey] > warnThreshold)
        RiskBadge.Parent = Frame
    end
    
    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0, 55, 0, 20)
    ValueLabel.Position = UDim2.new(1, -70, 0, 8)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(QuantumConfig[configKey]) .. (warnThreshold == 70 and "%" or "")
    ValueLabel.TextColor3 = Themes[QuantumConfig.Theme]
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextSize = 13
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Parent = Frame
    
    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, -32, 0, 8)
    SliderBG.Position = UDim2.new(0, 16, 0, 36)
    SliderBG.BackgroundColor3 = ThemeColors.ControlBG
    SliderBG.Text = ""
    SliderBG.AutoButtonColor = false
    AddCorner(SliderBG, 4)
    SliderBG.Parent = Frame
    
    local initRel = math.clamp((QuantumConfig[configKey] - min) / (max - min), 0, 1)
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(initRel, 0, 1, 0)
    Fill.BackgroundColor3 = Themes[QuantumConfig.Theme]
    AddCorner(Fill, 4)
    Fill.Parent = SliderBG
    
    table.insert(ThemeElements, {
        inst = ValueLabel, 
        prop = "TextColor3",
        condition = function() return not (warnThreshold and QuantumConfig[configKey] > warnThreshold) end
    })
    table.insert(ThemeElements, {
        inst = Fill, 
        prop = "BackgroundColor3",
        condition = function() return not (warnThreshold and QuantumConfig[configKey] > warnThreshold) end
    })
    
    local warnedAlready = (warnThreshold and QuantumConfig[configKey] > warnThreshold) or false

    local function RefreshWarningVisuals(val)
        local isOver = (warnThreshold ~= nil and val > warnThreshold)
        if RiskBadge then
            RiskBadge.Visible = isOver
        end
        if isOver then
            Fill.BackgroundColor3 = ThemeColors.DangerRed
            ValueLabel.TextColor3 = ThemeColors.DangerRed
            FrameStroke.Color = ThemeColors.DangerRed
            if not warnedAlready then
                warnedAlready = true
                Notify("⚠ High Detection Risk", name .. " is over " .. tostring(warnThreshold) .. "%! Hard-locking can trigger anti-cheat.", 3.0, true)
            end
        else
            warnedAlready = false
            Fill.BackgroundColor3 = Themes[QuantumConfig.Theme]
            ValueLabel.TextColor3 = Themes[QuantumConfig.Theme]
            FrameStroke.Color = Color3.fromRGB(36, 40, 58)
        end
    end

    local function SyncSliderState()
        local val = QuantumConfig[configKey]
        local r = math.clamp((val - min) / (max - min), 0, 1)
        Fill.Size = UDim2.new(r, 0, 1, 0)
        ValueLabel.Text = tostring(val) .. (warnThreshold == 70 and "%" or "")
        RefreshWarningVisuals(val)
    end
    SyncSliderState()
    table.insert(UIControlRefreshers, SyncSliderState)

    TrackConnection(Frame.MouseEnter:Connect(function() 
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = ThemeColors.CardHover}):Play() 
        if not (warnThreshold and QuantumConfig[configKey] > warnThreshold) then
            TweenService:Create(FrameStroke, TweenInfo.new(0.18), {Color = Themes[QuantumConfig.Theme]}):Play()
        end
    end))
    TrackConnection(Frame.MouseLeave:Connect(function() 
        TweenService:Create(Frame, TweenInfo.new(0.18), {BackgroundColor3 = ThemeColors.CardBG}):Play() 
        if not (warnThreshold and QuantumConfig[configKey] > warnThreshold) then
            TweenService:Create(FrameStroke, TweenInfo.new(0.18), {Color = Color3.fromRGB(36, 40, 58)}):Play()
        end
    end))

    local draggingSlider = false
    local function UpdateSliderFromInput(inputPosX)
        local absSize = math.max(SliderBG.AbsoluteSize.X, 1)
        local rel = math.clamp((inputPosX - SliderBG.AbsolutePosition.X) / absSize, 0, 1)
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        
        local value = min + (max - min) * rel
        if not isFloat then 
            value = math.floor(value + 0.5) 
        else 
            value = math.floor(value * 100 + 0.5) / 100 
        end
        
        QuantumConfig[configKey] = value
        ValueLabel.Text = tostring(value) .. (warnThreshold == 70 and "%" or "")
        RefreshWarningVisuals(value)
        
        if configKey == "MoonSize" or configKey == "Brightness" then 
            UpdateWorld() 
        end
        if callback then callback(value) end
    end

    TrackConnection(SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            UpdateSliderFromInput(input.Position.X)
        end
    end))
    TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            draggingSlider = false 
        end
    end))
    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSliderFromInput(input.Position.X)
        end
    end))
end

