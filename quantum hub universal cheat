        atmosphere.Color = Color3.fromRGB(255, 120, 60)
        atmosphere.Haze = 0.3
        cc.TintColor = Color3.fromRGB(255, 200, 180)
    elseif theme == "Thunderstorm" then
        Lighting.ClockTime = 12
        if not QuantumConfig.Fullbright then Lighting.Brightness = 0.3 end
        atmosphere.Density = 0.6
        atmosphere.Haze = 2
        atmosphere.Color = Color3.fromRGB(50, 55, 65)
        cc.Saturation = -0.5
    elseif theme == "Cosmic Nebula" then
        Lighting.ClockTime = 0
        atmosphere.Color = Color3.fromRGB(140, 40, 255)
        sky.StarCount = 15000
        cc.TintColor = Color3.fromRGB(220, 180, 255)
    elseif theme == "Inferno Sky" then
        Lighting.ClockTime = 15
